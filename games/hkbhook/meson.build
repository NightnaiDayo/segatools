shared_library(
    'hkbhook',
    name_prefix : '',
    include_directories : inc,
    implicit_include_directories : false,
    vs_module_defs : 'hkbhook.def',
    dependencies : [
        capnhook.get_variable('hook_dep'),
        capnhook.get_variable('hooklib_dep'),
    ],
    link_with : [
        aimeio_lib,
        board_lib,
        gfxhook_lib,
        hooklib_lib,
        hkbio_lib,
        platform_lib,
        unityhook_lib,
        util_lib,
    ],
    sources : [
        'amptw.c',
        'amptw.h',
        'config.c',
        'config.h',
        'dllmain.c',
        'io4.c',
        'io4.h',
        'hkb-dll.c',
        'hkb-dll.h',
    ],
)
