shared_library(
    'soulhook',
    name_prefix : '',
    include_directories : inc,
    implicit_include_directories : false,
    vs_module_defs : 'soulhook.def',
    dependencies : [
        capnhook.get_variable('hook_dep'),
        capnhook.get_variable('hooklib_dep'),
        xinput_lib,
    ],
    link_with : [
        aimeio_lib,
        amex_lib,
        board_lib,
        hooklib_lib,
        soulio_lib,
        platform_lib,
        util_lib,
    ],
    sources : [
        'config.c',
        'config.h',
        'dllmain.c',
        'io4.c',
        'io4.h',
        'soul-dll.c',
        'soul-dll.h',
        'soul-gfx.c',
        'soul-gfx.h',
    ],
)
